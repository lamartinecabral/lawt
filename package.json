{
  "name": "lawt",
  "version": "0.0.1",
  "description": "Local AI With Tools",
  "type": "module",
  "bin": {
    "lawt": "./src/cli.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install:global": "chmod +x src/cli.ts && npm link",
    "start": "node src/cli.ts",
    "test": "node --test",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "ai",
    "agent",
    "openai",
    "ollama"
  ],
  "license": "MIT",
  "dependencies": {
    "@lamartinecabral/web-search": "github:lamartinecabral/web-search",
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "fast-glob": "3.3.3",
    "openai": "7.15.0",
    "ora": "9.4.1",
    "picocolors": "1.1.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24",
    "typescript": "6.0.3"
  }
}
