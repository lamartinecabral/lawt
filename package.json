    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "openai": "^6.45.0",
    "ora": "^9.3.0",
    "picocolors": "^1.1.1",
    "puppeteer-core": "25.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24",
    "eslint": "^10.2.1",
    "globals": "^17.4.0",
    "prettier": "^3.8.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59.0"
