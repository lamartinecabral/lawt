{
  "name": "minicode",
  "version": "1.0.0",
  "description": "CLI AI agent powered by Ollama for file operations and multi-step tasks",
  "type": "module",
  "bin": {
    "minicode": "./dist/bin/cli.js"
  },
  "scripts": {
    "dev": "tsx src/bin/cli.ts",
    "build": "rimraf dist && tsup",
    "start": "node dist/bin/cli.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:e2e"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "cli",
    "ai",
    "ollama",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.4",
    "ollama": "^0.6.3",
    "ora": "^9.3.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "execa": "^9.6.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.2",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  }
}
