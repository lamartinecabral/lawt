    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.4",
    "ollama": "^0.6.3",
    "ora": "^9.3.0",
    "picocolors": "^1.1.1",
    "puppeteer-core": "25.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "execa": "^9.6.1",
    "globals": "^17.4.0",
    "prettier": "^3.8.2",
