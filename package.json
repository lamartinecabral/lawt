{
  "name": "minicode",
  "version": "0.1.0",
  "description": "A local-first Node.js CLI coding agent scaffold",
  "main": "dist/index.js",
  "bin": {
    "agent": "dist/index.js"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "npm run build -- --watch",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "start": "npm run build && node dist/index.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "12.8.0",
    "chalk": "5.6.2",
    "commander": "14.0.3",
    "cosmiconfig": "9.0.1",
    "nanoid": "5.1.7",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "8.58.1",
    "eslint": "10.2.0",
    "prettier": "3.8.1",
    "rimraf": "6.1.3",
    "tsup": "8.5.1",
    "typescript": "6.0.2",
    "vitest": "4.1.3"
  }
}
