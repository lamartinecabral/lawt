{
  "name": "minicode",
  "version": "0.0.1-alpha",
  "description": "A lightweight AI agent CLI powered by Ollama",
  "type": "module",
  "bin": {
    "minicode": "./src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "cli",
    "ai",
    "agent",
    "ollama"
  ],
  "license": "ISC",
  "dependencies": {
    "commander": "^14.0.3",
    "ollama": "^0.6.3",
    "ora": "^9.3.0",
    "picocolors": "^1.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.0",
    "execa": "^9.6.1",
    "globals": "^17.4.0",
    "prettier": "^3.8.2",
    "vitest": "^4.1.4"
  }
}
